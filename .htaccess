<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Compatibility for hosts whose document root is the project directory.
    # Let public/.htaccess handle Laravel routes and serve public assets there.
    # Stop on the internal rewrite to avoid adding public/ repeatedly.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
